# Public URL of your deployed worker
BRAIN_URL=https://your-brain.yourdomain.com

# --- Auth: per-tenant key->tenant binding (recommended) ---
# Each tenant gets its own key, set as a Wrangler secret in production:
#   wrangler secret put API_KEY_COMPANION
#   wrangler secret put API_KEY_RAINER
# The bearer that matches ONE of these IS that tenant — there is no separate tenant
# selection. Single-tenant self-host: bind ONLY ONE of these and that tenant is the
# only one reachable, by construction (X-Brain-Tenant header is ignored/cross-checked).
API_KEY_COMPANION=replace-with-a-long-random-secret
API_KEY_RAINER=replace-with-a-different-long-random-secret

# --- Auth: legacy shared key (DEPRECATED) ---
# If set, a bearer matching this authenticates via the OLD header-derived-tenant model
# (X-Brain-Tenant chooses the tenant, defaulting to "rainer" if absent) and logs a
# deprecation warning on every request. Delete this once every tenant above has its own
# API_KEY_<TENANT> secret bound — rotation is then a pure secrets operation, zero downtime.
# See ops/MICHAEL_TENANT_KEY_AUDIT_2026-07-06.md.
# API_KEY=replace-with-a-long-random-secret

# Neon Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Default tenant used by scripts/tools
BRAIN_TENANT=companion

# Runtime wake script auth (usually the API_KEY_<TENANT> value matching BRAIN_TENANT above)
BRAIN_API_KEY=replace-with-a-long-random-secret

# --- Optional tenant vocabulary overrides (all default to the compiled-in list) ---
# Comma-separated tenant list, overriding the compiled-in ["companion", "rainer"]
# ALLOWED_TENANTS=companion,rainer
# Alias map for reconciling client/server tenant-name drift, e.g. a proxy that still
# speaks "rook": ALIAS:CANONICAL pairs, comma-separated
# TENANT_ALIASES=rook:companion
# Explicit cross-tenant READ grants for project-registry scope:"all" lookups and
# non-default mind_runtime agent_tenant. GRANTER:GRANTED pairs, comma-separated.
# Default: empty (no tenant may cross-read another's data).
# CROSS_TENANT_READ_GRANTS=rainer:companion,companion:rainer

# Optional runner defaults
WAKE_KIND=duty
TRIGGER_MODE=schedule
AUTO_CLAIM_TASK=true
ENFORCE_POLICY=true
EMIT_SKILL_CANDIDATE=true

# Comma-separated list of allowed CORS origins (used by the Worker)
CORS_ORIGINS=https://your-app.example.com

# Storage backend (postgres | sqlite)
STORAGE_BACKEND=postgres

# Local sqlite file path (used when STORAGE_BACKEND=sqlite)
SQLITE_PATH=./muse-brain.sqlite
